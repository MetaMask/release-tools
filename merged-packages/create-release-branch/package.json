{
  "name": "@metamask/create-release-branch",
  "version": "4.2.2",
  "description": "An interactive command-line tool to prepare a release branch by automatically bumping versions and updating changelogs for desired packages. Works for both polyrepos and monorepos.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/create-release-branch.git"
  },
  "bin": "bin/create-release-branch.js",
  "files": [
    "bin/",
    "dist/"
  ],
  "type": "module",
  "exports": null,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && yarn build:ui",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "build:ui": "vite build",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/create-release-branch",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/create-release-branch",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@metamask/action-utils": "^2.0.0",
    "@metamask/auto-changelog": "^6.1.1",
    "@metamask/utils": "^9.0.0",
    "debug": "^4.3.4",
    "execa": "^8.0.1",
    "express": "^4.21.2",
    "open": "^10.1.0",
    "pony-cause": "^2.1.9",
    "semver": "^7.5.4",
    "validate-npm-package-name": "^5.0.0",
    "which": "^3.0.0",
    "yaml": "^2.2.2",
    "yargs": "^17.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/plugin-transform-modules-commonjs": "^7.23.3",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-typescript": "^7.23.3",
    "@tailwindcss/vite": "^4.0.9",
    "@types/debug": "^4.1.7",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/validate-npm-package-name": "^4.0.2",
    "@types/which": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^4.1.11",
    "deepmerge": "^4.2.2",
    "vitest-when": "^1.0.0",
    "nanoid": "^3.3.4",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rimraf": "^4.0.5",
    "stdio-mock": "^1.2.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.6.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "oxfmt": "^0.45.0",
    "prettier": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "engines": {
    "node": "^18.18 || >=20"
  },
  "packageManager": "yarn@4.16.0",
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "tsx>esbuild": false,
      "vite>esbuild": false
    }
  }
}
