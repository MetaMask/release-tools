{
  "name": "@metamask/apply-release-plan",
  "version": "0.0.0",
  "description": "Fork of @changesets/apply-release-plan with support for categorized (Keep a Changelog style) changelog sections",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/release-tools/tree/main/packages/apply-release-plan#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/release-tools/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/release-tools.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/apply-release-plan",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/apply-release-plan",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@changesets/config": "4.0.0",
    "@changesets/format": "0.1.2",
    "@changesets/git": "4.0.1",
    "@changesets/should-skip-package": "1.0.0",
    "@changesets/types": "7.0.0",
    "import-meta-resolve": "^4.2.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@manypkg/get-packages": "^3.1.0",
    "@metamask/auto-changelog": "^6.1.0",
    "@types/node": "^22.13.14",
    "@types/semver": "^7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^4.1.11",
    "fs-fixture": "^2.16.0",
    "rimraf": "^5.0.5",
    "tinyexec": "^1.3.1",
    "typedoc": "^0.25.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.14.0 || ^24"
  }
}
