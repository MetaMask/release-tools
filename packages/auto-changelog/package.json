{
  "name": "@metamask/auto-changelog",
  "version": "6.2.1",
  "description": "Utilities for validating and updating \"Keep a Changelog\" formatted changelogs",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/release-tools/tree/main/packages/auto-changelog#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/release-tools/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/release-tools.git"
  },
  "bin": "bin/auto-changelog.js",
  "files": [
    "bin/",
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/auto-changelog",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/auto-changelog",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:package": "attw --pack",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.0",
    "diff": "^5.0.0",
    "execa": "^8.0.1",
    "semver": "^7.8.5",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.3",
    "@types/diff": "^5.0.0",
    "@types/node": "^22.13.14",
    "@types/semver": "^7",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-istanbul": "^5.0.1",
    "nock": "^14.0.17",
    "outdent": "^0.8.0",
    "oxfmt": "^0.45.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5",
    "typedoc": "^0.25.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "oxfmt": "^0.45.0",
    "prettier": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.16.0 || ^24"
  }
}
