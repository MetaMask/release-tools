{
  "name": "@metamask/changesets-lint",
  "version": "0.0.0",
  "description": "A CLI for validating Changeset files against MetaMask conventions",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/release-tools/tree/main/packages/changesets-lint#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/release-tools/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/release-tools.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/changesets-lint",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/changesets-lint",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@changesets/parse": "^1.0.0",
    "@changesets/types": "^7.0.0",
    "@metamask/changesets-utils": "^0.0.0",
    "yaml": "^2.2.2"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.2.1",
    "@types/node": "^22.13.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "rimraf": "^5.0.5",
    "typedoc": "^0.25.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.16.0 || ^24"
  }
}
