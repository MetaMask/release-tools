{
  "$schema": "https://unpkg.com/@changesets/config@3.1.2/schema.json",
  "changelog": [
    "@metamask/changesets-changelog",
    { "repository": "MetaMask/release-tools" }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "changedFilePatterns": [
    "**",
    "!CHANGELOG.md",
    "!docs/**",
    "!**/docs/**",
    "!tests/**",
    "!**/tests/**",
    "!__tests__/**",
    "!**/__tests__/**",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "updateInternalDependencies": "patch",
  "format": "oxfmt",
  "ignore": []
}
